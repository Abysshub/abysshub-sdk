{
  "name": "abysshub",
  "version": "0.0.0",
  "description": "Run a hosted tool, an Abyss Widget, from your own JavaScript or TypeScript code and get its result and files. The official library for the Abyss API.",
  "keywords": [
    "abyss",
    "abysshub",
    "widget",
    "run",
    "hosted tools",
    "python tools",
    "automation",
    "file upload",
    "api client",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://abysshub.com/docs#api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abysshub/abysshub-sdk.git",
    "directory": "js"
  },
  "bugs": "https://github.com/Abysshub/abysshub-sdk/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/version.js && tsc",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  }
}
